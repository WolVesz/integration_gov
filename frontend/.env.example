# Copy to .env.local and rebuild. VITE_* values are public, never secrets.
VITE_APP_NAME=Integration Governance
VITE_ORGANIZATION_NAME=
# Optional assets: add files to frontend/public, then use /organization-logo.svg
# or another same-origin absolute path. Keep the neutral fallback favicon.
VITE_LOGO_PATH=
VITE_FAVICON_PATH=/favicon.svg
# Quote six-digit hex colors. Invalid colors or white contrast below 4.5:1
# fall back to neutral defaults. Lifecycle status colors remain semantic.
VITE_PRIMARY_COLOR="#374151"
VITE_PRIMARY_DARK_COLOR="#1f2937"
VITE_ACCENT_COLOR="#4b5563"
