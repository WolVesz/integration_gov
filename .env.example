# LOCAL DEVELOPMENT ONLY. Never package or sync a populated .env to Databricks.
DEV_MODE=true
DEV_USER_EMAIL=dev.user@example.com
DEV_USER_NAME=Dev User
DEV_USER_ROLE=integration
APP_NAME=Integration Governance
DATABASE_URL=sqlite:///./integration_gov.db
ADMIN_GROUPS=integration-admins
GROUP_CACHE_TTL_SECONDS=300

# Production: DEV_MODE=false; use the approved existing database and workspace
# groups. Configure Databricks Apps resources/environment, not copied secrets.
# LAKEBASE_INSTANCE_NAME=<approved-existing-instance>
# LAKEBASE_DATABASE=<approved-existing-database>
# LAKEBASE_USER=<approved-database-identity>  # if not provided by PGUSER
# EMBEDDING_ENDPOINT=<approved-serving-endpoint>  # optional
# Databricks Apps injects workspace OAuth credentials. Do not put them here.
